<div id="<%= dom_id cat %>">
  <div>
    <strong>Name:</strong>
    <%= cat.name %>
  </div>

  <div>
    <strong>Images:</strong>
    <%= cat.images %>
  </div>

  <div>
    <strong>Age:</strong>
    <%= cat.age %>
  </div>

  <div>
    <strong>Gender:</strong>
    <%= cat.gender %>
  </div>

  <div>
    <strong>Stayed or neutered:</strong>
    <%= cat.stayed_or_neutered %>
  </div>

  <div>
    <strong>Tags:</strong>
    <%= cat.tags %>
  </div>

</div>
