<div class="images">
  <% @cat.images.each do |img| %>
    <div class="image">
      <%= image_tag img, alt: @cat.name %>
    </div>
  <% end %>
</div>

<div class="cat-container">
  <h2><%= @cat.name %> (<%= @cat.age %> éves)</h2>
  
  <p><strong>About:</strong> <%= @cat.gender == 0 ? "Fiú" : "Lány" %>, <%= @cat.spayed_or_neutered ? "Ivartalanított" : "Nem ivartalanított" %></p>
  
  <div class="cat-container-tags">
    <% @cat.tags.each do |tag| %>
      <span class="cat-container-tag">#<%= tag %></span>
    <% end %>
  </div>

  <div class="desc">
    <% @cat.desc.each do |paragraph| %>
      <p><%= paragraph %></p>
    <% end %>
  </div>

  <div class="button-div">
    <%= button_to "Adopt", adopt_cat_path(@cat.id), method: :post, class: "adopt-button" %>
  </div>
</div>