<div class="user-edit-container">
  <h1>Registration</h1>
  <fieldset class="user-fieldset">
    <legend>Register a new user</legend>
    <%= form_for @user, url: register_path, method: :post do |form| %>
      <div class="form-group">
        <%= form.label :name, "Name:" %>
        <%= form.text_field :name, size: 25, required: true %>
      </div>
      <div class="form-group">
        <%= form.label :email, "Email:" %>
        <%= form.text_field :email, size: 25, required: true %>
      </div>
      <div class="form-group">
        <%= form.label :password, "Password:" %>
        <%= form.password_field :password, size: 25 %>
      </div>
      <div class="form-group">
        <%= form.label :password_confirmation, "Password again:" %>
        <%= form.password_field :password_confirmation, size: 25 %>
      </div>
      <div class="form-actions">
        <%= form.submit 'Register', class: "btn-submit" %>
      </div>
    <% end %>
  </fieldset>
</div>
