<div class="user-edit-container">
  <h1>Forgotten password</h1>

  <fieldset class="user-fieldset">
    <legend>Recover forgotten password</legend>
    <%= form_for @user, url: recover_path, method: :post do |form| %>
      <div class="form-group">
        <%= form.label :email, "Email:" %>
        <%= form.text_field :email, size: 30 %>
      </div>

      <div class="form-actions">
        <%= form.submit "Recover", class: "btn-submit" %>
      </div>
    <% end %>
  </fieldset>

  <div class="user-bottom-actions">
    <%= link_to "Back", :back, class: "btn-back" %>
  </div>
</div>